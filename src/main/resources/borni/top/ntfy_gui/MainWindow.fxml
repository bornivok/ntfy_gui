    <Label text="Tag (Címke):" />
    <ComboBox fx:id="tagComboBox" prefHeight="32.0" prefWidth="250.0" />

    <Label text="Fejléc - max 64 karakter:" />
    <TextField fx:id="titleField" prefHeight="30.0" promptText="Ide írd a címet..." />

    <Label text="Üzenet - max 255 karakter:" />
    <TextArea fx:id="messageArea" prefHeight="150.0" promptText="Ide írd az üzenetet..." wrapText="true" />

    <Button fx:id="sendButton" onAction="#onSendClicked" prefHeight="40.0" prefWidth="350.0" style="-fx-font-weight: bold; -fx-padding: 10px;" text="Üzenet küldése" />
</VBox>
