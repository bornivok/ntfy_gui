    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@ntfy.png" />
      </image>
      <VBox.margin>
         <Insets left="177.5" />
      </VBox.margin>
   </ImageView>

    <Label text="Szerver kiválasztása:" />
    <HBox spacing="10.0">
        <ComboBox fx:id="serverComboBox" prefHeight="32.0" prefWidth="320.0" promptText="Válassz szervert..." />
