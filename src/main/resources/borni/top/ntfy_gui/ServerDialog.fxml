<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="borni.top.ntfy_gui.Controller.ServerDialogController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Szerver megnevezése:" />
    <TextField fx:id="nameField" promptText="Név..." />

    <Label text="Szerver URL:" />
    <TextField fx:id="urlField" promptText="https://..." />

    <CheckBox fx:id="authCheckBox" text="Hitelesítés szükséges" />

    <Label text="API Token (csak ha hitelesítés szükséges):" />
    <TextField fx:id="tokenField" promptText="tk_..." />

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <padding>
            <Insets top="15.0" />
        </padding>
        <!-- A törlés gomb alapból piros lesz a stílus miatt -->
        <Button fx:id="deleteButton" onAction="#onDeleteClicked" style="-fx-text-fill: red;" text="Törlés" />

        <!-- Üres helykitöltő (spacer) a gombok közé -->
        <HBox HBox.hgrow="ALWAYS" />

        <Button onAction="#onCancelClicked" text="Mégse" />
        <Button fx:id="saveButton" onAction="#onSaveClicked" style="-fx-font-weight: bold;" text="Mentés" />
    </HBox>
</VBox>
